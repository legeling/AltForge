    "HU5-Hv-E3d.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Free-account signatures usually last 7 days. Refresh while AltForge Server is reachable before they expire.\"; ObjectID = \"HU5-Hv-E3d\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Free-account signatures usually last 7 days. Refresh while AltForge Server is reachable before they expire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料アカウントの署名は通常7日間有効です。期限切れ前にAltForge Serverへ接続して更新してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assinaturas de contas gratuitas normalmente duram 7 dias. Atualize antes do vencimento com o AltForge Server acessível."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费账号签名通常有效 7 天。请在到期前连接 AltForge Server 刷新。"
          }
        }
      }
    },
