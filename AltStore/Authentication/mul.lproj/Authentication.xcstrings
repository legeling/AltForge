    "6HP-Xh-sAH.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Keep AltForge Server open on your Mac or Windows PC while installing or refreshing apps.\"; ObjectID = \"6HP-Xh-sAH\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep AltForge Server open on your Mac or Windows PC while installing or refreshing apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのインストールや更新中は、MacまたはWindows PCでAltForge Serverを開いたままにします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o AltForge Server aberto no Mac ou PC com Windows durante a instalação ou atualização de apps."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装或刷新应用时，请在 Mac 或 Windows 电脑上保持 AltForge Server 运行。"
