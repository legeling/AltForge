    "on2-62-waY.text" : {
      "comment" : "Class = \"UILabel\"; text = \"AltForge asks Apple for the developer teams linked to this Apple ID, selects the best available team, and shows it in Settings. Credentials stay in this device's Keychain and are sent only to Apple for authentication.\"; ObjectID = \"on2-62-waY\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AltForge asks Apple for the developer teams linked to this Apple ID, selects the best available team, and shows it in Settings. Credentials stay in this device's Keychain and are sent only to Apple for authentication."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForgeはAppleからこのApple IDに関連付けられたデベロッパチームを取得し、最適なチームを選択して設定に表示します。認証情報はこのデバイスのキーチェーンに保存され、認証のためにのみAppleへ送信されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AltForge consulta na Apple as equipes vinculadas a este Apple ID, seleciona a melhor disponível e a mostra nos Ajustes. As credenciais ficam no Chaveiro do dispositivo e são enviadas apenas à Apple para autenticação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge 会向 Apple 查询此 Apple ID 关联的开发者团队，自动选择最合适的团队，并在设置中显示。凭据仅保存在本设备的 Keychain 中，并且只发送给 Apple 进行身份验证。"
          }
        }
      }
    },
    "p9U-0q-Kn8.text" : {
