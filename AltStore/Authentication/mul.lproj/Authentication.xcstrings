    "on2-62-waY.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Your Apple ID is used to configure apps so they can be installed on this device. Your credentials will be stored securely in this device's Keychain and sent only to Apple for authentication.\"; ObjectID = \"on2-62-waY\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your Apple ID is used to configure apps so they can be installed on this device. Your credentials will be stored securely in this device's Keychain and sent only to Apple for authentication."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple IDは、アプリをこのデバイスにインストールできるように設定するために使用されます。認証情報は、このデバイスのキーチェーンに安全に保存され、認証のためにのみAppleに送信されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Apple ID é usado para configurar apps e permitir sua instalação neste dispositivo. Suas credenciais serão armazenadas com segurança no Chaveiro do dispositivo e enviadas apenas à Apple para autenticação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 Apple ID 用于配置应用，以便将它们安装在此设备上。您的凭据将安全地存储在此设备的 Keychain 中，并且仅发送给 Apple 进行身份验证。"
          }
        }
      }
    },
