    "M7T-9j-uyt.text" : {
      "comment" : "Class = \"UILabel\"; text = \"AltForge selects your Apple developer team, signs the app, then sends it through AltForge Server.\"; ObjectID = \"M7T-9j-uyt\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AltForge selects your Apple developer team, signs the app, then sends it through AltForge Server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForgeがAppleデベロッパチームを選択してアプリに署名し、AltForge Server経由で送信します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AltForge seleciona sua equipe Apple, assina o app e o envia pelo AltForge Server."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge 会自动选择您的 Apple 开发者团队，为应用签名，再通过 AltForge Server 发送。"
          }
        }
      }
    },
