    "4rk-ge-FSj.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Enable iTunes Wi-Fi Sync and connect to the same Wi-Fi as AltServer.\"; ObjectID = \"4rk-ge-FSj\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable iTunes Wi-Fi Sync and connect to the same Wi-Fi as AltServer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTunes Wi-Fi同期を有効にし、AltServerと同じWi-Fiに接続してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a Sincronização via Wi‑Fi do iTunes e conecte-se à mesma rede Wi‑Fi que o AltServer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用 iTunes Wi-Fi 同步并连接到与 AltServer 相同的 Wi-Fi。"
          }
        }
      }
    },
