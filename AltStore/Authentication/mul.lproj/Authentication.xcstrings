    "4rk-ge-FSj.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Connect by USB, or enable Wi-Fi sync and put both devices on the same network.\"; ObjectID = \"4rk-ge-FSj\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connect by USB, or enable Wi-Fi sync and put both devices on the same network."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USBで接続するか、Wi-Fi同期を有効にして両方のデバイスを同じネットワークに接続します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte por USB ou ative a sincronização por Wi‑Fi e coloque os dois dispositivos na mesma rede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 USB 连接，或启用 Wi-Fi 同步并让两台设备接入同一网络。"
          }
        }
      }
    },
