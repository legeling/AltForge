    "While AltStore 2.0 is in beta, you may choose to ignore this warning at your own risk until the source is updated." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltStore 2.0はベータ版ですが、ソースがアップデートされるまでは自己責任でこの警告を無視することもできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto o AltStore 2.0 estiver em versão beta, você pode ignorar este aviso por sua conta e risco até que a fonte seja atualizada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在软件源更新之前，您可以选择忽略此警告，但需自行承担风险。"
          }
        }
      }
    },
    "USB-connected AltForge Server" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有線AltForge Server"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge Server via cabo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 USB 连接的 AltForge Server"
          }
        }
      }
    },
    "Would you like to add the source “%@”?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソース「%@」を追加しますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaria de adicionar a fonte “%@”?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您想添加软件源“%@”吗？"
          }
        }
      }
    },
    "Would you like to bridge your Bluesky account to the fediverse?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blueskyアカウントをフェディバースにブリッジしますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaria de vincular sua conta do Bluesky ao fediverse?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您想将您的 Bluesky 账户桥接到 fediverse 吗？"
          }
        }
      }
    },
    "Would you like to download the last version compatible with this device instead?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代わりに、このデバイスと互換性のある最新バージョンをダウンロードしますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaria de baixar a última versão compatível com este dispositivo?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您想下载与此设备兼容的最新版本吗？"
          }
        }
      }
    },
    "Would you like to remove this app's extensions so they don't count towards your limit?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリの拡張機能を削除して、制限にカウントされないようにしますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaria de remover as extensões deste app para que não sejam contabilizadas no seu limite?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您想删除此应用的扩展程序，以便它们不会计入您的限制吗？"
          }
        }
      }
    },
    "You are not signed in." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインしていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não está conectado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您尚未登录。"
          }
        }
      }
    },
    "You can register another App ID in %@." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@後に別のアプリIDを登録できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você poderá registrar outro App ID em %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以在 %@ 中注册另一个 App ID。"
          }
        }
      }
    },
    "You cannot register more than 10 App IDs within a 7 day period." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7日間で登録できるアプリIDは10件までです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não pode registrar mais de 10 App IDs em um período de 7 dias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您在 7 天内最多只能注册 10 个 App ID。"
          }
        }
      }
    },
    "You must add this source before installing apps from it.\n\n“%@” will begin downloading once it has been added." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このソースからアプリをインストールする前に、このソースを追加する必要があります。\n\n「%@」は追加されるとすぐにダウンロードを開始します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisa adicionar esta fonte antes de instalar apps a partir dela.\n\n“%@” começará a ser baixado assim que for adicionada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您必须先添加此软件源，然后才能从中安装应用。\n\n添加“%@”后将开始下载。"
          }
        }
      }
    },
    "You must also delete it from the home screen to fully uninstall the app." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを完全にアンインストールするには、ホーム画面からも削除する必要があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você também deve excluí-lo da tela inicial para desinstalar completamente o app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您还必须将其从主屏幕中删除才能完全卸载该应用。"
          }
        }
      }
    },
    "You will no longer be able to install or refresh any apps that require pledges." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支援を必要とするアプリのインストールや更新ができなくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não poderá mais instalar ou atualizar apps que exijam contribuição."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您将无法再安装或刷新任何需要赞助的应用。"
          }
        }
      }
    },
    "You will no longer be able to install or refresh apps once you sign out." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインアウトすると、アプリのインストールや更新ができなくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não poderá mais instalar ou atualizar aplicativos após sair da conta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注销后，您将无法再安装或刷新应用。"
          }
        }
      }
    },
    "You will no longer be able to install or update any apps that require pledges." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支援を必要とするアプリのインストールやアップデートができなくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não poderá mais instalar ou atualizar apps que exijam contribuição."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您将无法再安装或更新任何需要赞助的应用。"
          }
        }
      }
    },
    "You will no longer be able to like apps, updates, and news items once you sign out." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインアウトすると、アプリやアップデート、ニュース記事に「いいね！」ができなくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao sair da conta, você não poderá mais curtir apps, atualizações e novidades."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出后，您将无法再为 App、更新和资讯点赞。"
          }
        }
      }
    },
    "You'll need to generate an app-specific password in your Bluesky settings." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blueskyの設定でアプリ固有のパスワードを生成する必要があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisará gerar uma senha específica de app nas configurações do Bluesky."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您需要在 Bluesky 设置中生成应用专用密码。"
          }
        }
      }
    },
    "You're signed into Patreon but haven't connected your account with AltForge.\n\nPlease connect your account to download Patreon-exclusive apps." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patreonにはサインインしていますが、アカウントがAltForgeと連携されていません。\n\nPatreon限定アプリをダウンロードするには、アカウントを連携してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está conectado ao Patreon, mas ainda não vinculou sua conta ao AltForge.\n\nConecte sua conta para baixar apps exclusivos do Patreon."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已登录 Patreon，但尚未将您的账户与 AltForge 连接。\n\n请连接您的账户以下载 Patreon 专属应用。"
          }
        }
      }
    },
    "You've received 1 month of free access to our “Early Adopter” Patreon tier!\n\nMake sure you have joined our Patreon campaign as a free member and connected your Patreon account in Settings." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アーリーアダプター」Patreonティアの1か月間無料アクセス権を獲得しました！\n\n無料メンバーとしてPatreonキャンペーンに参加し、「設定」でPatreonアカウントを連携していることをご確認ください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você recebeu 1 mês de acesso gratuito ao nosso nível “Early Adopter” no Patreon!\n\nCertifique-se de que você entrou em nossa campanha no Patreon como membro gratuito e conectou sua conta do Patreon em Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已获得我们“早期采用者”Patreon 级别的 1 个月免费访问权！\n\n确保您已作为免费会员加入我们的 Patreon 活动，并在“设置”中连接您的 Patreon 账户。"
          }
        }
      }
    },
    "Your Apple ID has no developer teams." : {
