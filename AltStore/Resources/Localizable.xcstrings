    "There is no certificate with the requested serial number for this team." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该团队中没有与请求序列号匹配的证书。"
          }
        }
      }
    },
    "There is no provisioning profile with the requested identifier on this team." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该团队中没有与请求标识符匹配的描述文件。"
