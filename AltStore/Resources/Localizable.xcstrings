    "Make sure your computer's date & time matches your iOS device and try again. You may need to re-install AltStore with AltServer if the problem persists." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure your computer's date & time matches your iOS device and try again. You may need to re-install AltForge with AltForge Server if the problem persists."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータとiOSデバイスの日付と時刻が一致していることを確認して、もう一度お試しください。問題が解決しない場合は、AltForge ServerでAltForgeを再インストールする必要があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique-se de que a data e hora do computador correspondam às do dispositivo iOS e tente novamente. Se o problema persistir, talvez seja necessário reinstalar o AltForge usando o AltForge Server."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认电脑与 iOS 设备的日期和时间一致，然后重试。如果问题持续存在，可能需要通过 AltForge Server 重新安装 AltForge。"
          }
        }
      }
    },
    "Make sure you're on the same Wi-Fi network as a computer running AltForge Server, or try connecting this device to your computer via USB." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge Serverを実行しているコンピュータと同じWi-Fiネットワークに接続していることを確認するか、このデバイスをUSB経由でコンピュータに接続してみてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se você está na mesma rede Wi-Fi de um computador com o AltForge Server em execução ou tente conectar este dispositivo ao computador via USB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保设备与运行 AltForge Server 的电脑位于同一 Wi-Fi 网络，或者尝试通过 USB 连接设备和电脑。"
          }
        }
      }
    },
