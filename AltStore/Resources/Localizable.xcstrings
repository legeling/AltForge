          }
        }
      }
    },
    "Check that the file is accessible, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认文件可以访问后重试。"
          }
        }
      }
    },
    "Check that this Apple ID can use Apple Developer services and has accepted the latest Apple agreements, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认此 Apple ID 可以使用 Apple 开发者服务，并已接受 Apple 的最新协议，然后重试。"
          }
        }
      }
    },
    "Check the Apple ID account status, device date and time, then sign in again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查 Apple ID 状态以及设备的日期与时间，然后重新登录。"
          }
        }
      }
    },
    "Check the Apple ID and password, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查 Apple ID 和密码后重试。"
          }
        }
      }
    },
    "Check the account status and network connection, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查账号状态和网络连接后重试。"
          }
        }
      }
    },
    "Check the computer's date and time, then update AltForge Server before retrying." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查电脑的日期与时间，更新 AltForge Server 后重试。"
          }
        }
      }
    },
    "Check the connection to AltForge Server, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查与 AltForge Server 的连接后重试。"
          }
        }
      }
    },
    "Check the device date and time. If the problem continues, try another trusted network." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查设备的日期与时间。如果问题仍然存在，请换用其他可信网络。"
          }
        }
      }
    },
    "Check the network and device date and time, then update AltForge Server before retrying." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查网络以及设备的日期与时间，更新 AltForge Server 后重试。"
          }
        }
      }
    },
    "Check the network connection and try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查网络连接后重试。"
          }
        }
      }
    },
    "Check the network, then update AltForge and AltForge Server before retrying." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查网络，更新 AltForge 和 AltForge Server 后重试。"
          }
        }
      }
    },
    "Check the source address and content. If it is maintained by someone else, contact the source maintainer." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查软件源地址和内容。如果软件源由他人维护，请联系维护者处理。"
          }
        }
      }
    },
    "Check this Mac's date and time, then update AltForge Server before retrying." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查这台 Mac 的日期与时间，更新 AltForge Server 后重试。"
          }
        }
      }
    },
    "Choose the app again and make sure it is a complete, unmodified IPA file." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重新选择 App，并确认它是完整且未经修改的 IPA 文件。"
          }
        }
      }
    },
    "Create an app-specific password at appleid.apple.com, then sign in with it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请前往 appleid.apple.com 创建 App 专用密码，然后使用该密码登录。"
          }
        }
      }
    },
    "Device Connection Failed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备连接失败"
          }
        }
      }
    },
    "Device Installation Failed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备安装失败"
          }
        }
      }
    },
    "Download or export the app again from a trusted source, then retry with the new IPA file." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请从可信来源重新下载或导出 App，再使用新的 IPA 文件重试。"
          }
        }
      }
    },
    "Download or export the app again from a trusted source, then retry with the new file." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请从可信来源重新下载或导出 App，再使用新文件重试。"
          }
        }
      }
    },
    "Enter the latest six-digit verification code sent to your trusted Apple device." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入发送到受信任 Apple 设备上的最新六位验证码。"
          }
        }
      }
    },
    "File or Data Could Not Be Read" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取文件或数据"
          }
        }
      }
    },
    "For your safety, installation was stopped. Download the app again from its trusted original source." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为保障安全，安装已停止。请从可信的原始来源重新下载 App。"
          }
        }
      }
    },
    "JIT Could Not Be Enabled" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法启用 JIT"
          }
        }
      }
    },
    "Keep the device unlocked and connected to this computer, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请保持设备解锁并连接到这台电脑，然后重试。"
          }
        }
      }
    },
    "Keep the device unlocked and connected, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请保持设备解锁并连接，然后重试。"
          }
        }
      }
    },
    "Keep the device unlocked and open More Details for the device's installation reason." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请保持设备解锁，并打开“更多详情”查看设备返回的安装失败原因。"
          }
        }
      }
    },
    "Mail Plug-In Operation Failed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邮件插件操作失败"
          }
        }
      }
    },
    "Network Request Failed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络请求失败"
          }
        }
      }
    },
    "Open More Details to check the process and exit code, then update the related dependency before retrying." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请打开“更多详情”查看进程和退出码，更新相关依赖后重试。"
          }
        }
      }
    },
    "Open Settings, reconnect the required account, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请打开“设置”，重新连接所需账号后重试。"
          }
        }
      }
    },
    "Reconnect and unlock the device, then trust this computer when prompted." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重新连接并解锁设备，并在提示时信任这台电脑。"
          }
        }
      }
    },
    "Reconnect the device and try again. If the problem continues, restart AltForge Server." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重新连接设备后重试。如果问题仍然存在，请重新启动 AltForge Server。"
          }
        }
      }
    },
    "Reconnect the device by USB, unlock it, and confirm that this computer is trusted." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请通过 USB 重新连接并解锁设备，然后确认已信任这台电脑。"
          }
        }
      }
    },
    "Required Process Failed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要进程运行失败"
          }
        }
      }
    },
    "Select the file again and make sure it has not been moved or deleted." : {
      "localizations" : {
        "zh-Hans" : {
