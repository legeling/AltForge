          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 AltForge Server。"
          }
        }
      }
    },
    "AltForge can only install marketplace apps that have been notarized by Apple." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForgeはAppleによって公証済みのマーケットプレイスアプリのみをインストールできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AltForge só pode instalar apps de marketplace que tenham sido notarizados pela Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge 只能安装经过 Apple 公证的市场应用。"
          }
        }
      }
    },
    "AltForge could not determine this device's UDID." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForgeはこのデバイスのUDIDを特定できませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AltForge não conseguiu determinar o UDID deste dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge 无法确定该设备的 UDID。"
          }
        }
      }
    },
    "AltForge does not have detailed information for these entitlements." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
