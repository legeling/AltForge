    "A placeholder app needs to be installed in order to prepare your device for untethering.\n\nThis may take a few moments." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アンテザードの準備のため、プレースホルダーアプリをインストールする必要があります。\n\nこれには数分かかる場合があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
