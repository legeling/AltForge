        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple IDs de não desenvolvedor estão limitados a três apps ativos. Escolha um app para desativar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非开发者 Apple ID 仅限 3 个活动应用。请选择要停用的应用。"
          }
        }
      }
    },
    "Non-developer Apple IDs are limited to 3 apps and app extensions. Inactive apps don't count towards your total, but cannot be opened until activated." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非開発者用Apple IDでは、アプリとアプリ拡張機能は3つまでに制限されます。非アクティブなアプリは合計数にはカウントされませんが、アクティブ化されるまで開くことはできません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple IDs de não desenvolvedor estão limitados a três apps e extensões. Apps inativos não são contabilizados no total, mas permanecem inacessíveis até serem reativados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非开发者 Apple ID 仅限 3 个应用和应用扩展。不活动的应用不会计入总数，但在激活之前无法打开。"
          }
        }
      }
    },
    "Non-developer Apple IDs are limited to 3 apps. Inactive apps are backed up and uninstalled so they don't count towards your total, but will be reinstalled with all their data when activated again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非開発者用Apple IDでは、アプリは3つまでに制限されます。非アクティブなアプリはバックアップされアンインストールされるため、合計数にはカウントされませんが、再度アクティブ化すると、すべてのデータと共に再インストールされます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple IDs de não desenvolvedor estão limitados a 3 apps. Apps inativos são salvos em backup e desinstalados para não serem contabilizados no total, mas serão reinstalados com todos os dados quando ativados novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非开发者 Apple ID 仅限 3 个应用。不活动的应用会被备份和卸载，因此它们不会计入您的总数，但在再次激活时将重新安装其所有数据。"
          }
        }
      }
    },
    "Non-developer Apple IDs are limited to creating 10 App IDs per week." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非開発者用Apple IDでは、1週間に作成できるアプリIDは10個までです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple IDs de não desenvolvedor podem criar até 10 App IDs por semana."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非开发者 Apple ID 每周最多只能创建 10 个 App ID。"
          }
        }
      }
    },
