    },
    "AltForge was denied permission to launch %@." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForgeは%@を起動する権限を拒否されました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AltForge teve a permissão negada para iniciar o %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge 被拒绝启动 %@ 的权限。"
          }
        }
      }
    },
    "AltForge was unable to use an existing signing certificate, so it had to create a new one. This will cause any apps installed with an existing certificate to expire — including AltForge.\n\nTo prevent AltForge from expiring early, please refresh the app now. AltForge will quit once refreshing is complete." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForgeは既存の署名証明書を使用できなかったため、新しい証明書を作成する必要がありました。これにより、既存の証明書でインストールされたアプリ（AltForgeを含む）はすべて期限切れとなります。\n\nAltForgeの早期期限切れを防ぐため、今すぐアプリを更新してください。更新が完了するとAltForgeは終了します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AltForge não conseguiu usar um certificado de assinatura existente, então precisou criar um novo. Isso fará com que quaisquer apps instalados com um certificado anterior expirem, incluindo o próprio AltForge.\n\nPara evitar que o AltForge expire antes do tempo, atualize o app agora. O AltForge será encerrado assim que a atualização for concluída."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge 无法使用现有签名证书，因此必须创建一个新证书。这将导致使用现有证书安装的所有 App 提前过期，其中也包括 AltForge。\n\n为了防止 AltForge 提前过期，请立即刷新 App。刷新完成后，AltForge 将退出。"
          }
        }
      }
    },
