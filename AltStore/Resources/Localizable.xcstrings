    "AltForge closed before this operation finished, so the result could not be recorded." : {
      "comment" : "Unexpected termination recovery error",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作が完了する前にAltForgeが終了したため、結果を記録できませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AltForge foi encerrado antes do fim da operação, portanto o resultado não pôde ser registrado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge 在操作完成前意外关闭，因此未能记录操作结果。"
          }
        }
      }
    },
    "AltForge does not operate a Patreon campaign. Link an account only to access apps from compatible sources that require a pledge." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge 不运营 Patreon 赞助计划。仅当兼容的软件源要求赞助权限时，才需要关联账户。"
          }
        }
      }
    },
    "AltForge Server" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge Server"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge Server"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge Server"
          }
        }
      }
    },
    "AltForge Server could not be found." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge Serverが見つかりませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
