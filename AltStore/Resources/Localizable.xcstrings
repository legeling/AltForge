    "Non-developer Apple IDs are limited to 3 active apps and app extensions, and “%@” contains %@ %@. Please choose an app to deactivate." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Non-developer Apple IDs are limited to 3 active apps and app extensions, and “%1$@” contains %2$@ %3$@. Please choose an app to deactivate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非開発者用Apple IDでは、アクティブなアプリとアプリ拡張機能は3つまでに制限され、「%1$@」は%2$@個の%3$@を含んでいます。無効にするアプリを1つ選んでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple IDs de não desenvolvedor estão limitados a três apps ativos e extensões de app ativas, e “%1$@” contém %2$@ %3$@. Escolha um app para desativar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非开发者 Apple ID 最多只能激活 3 个 App 和 App 扩展，而“%1$@”包含 %2$@ %3$@。请选择一个 App 停用。"
          }
        }
      }
    },
    "Non-developer Apple IDs are limited to 3 active apps and app extensions." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非開発者用Apple IDでは、アクティブなアプリとアプリ拡張機能は3つまでに制限されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
