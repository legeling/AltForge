{
  "sourceLanguage" : "en",
  "strings" : {
    "Deactivate one sideloaded app, then try again. If an offloaded app is still counted, reinstall or delete it before retrying." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先停用一个侧载 App，然后重试。如果已卸载的 App 仍被计入，请重新安装或彻底删除后再试。"
          }
        }
      }
    },
    "Could not find matching provisioning profile." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到匹配的描述文件。"
          }
        }
      }
    },
    "Incorrect verification code." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证码不正确。"
          }
        }
      }
    },
    "The app is invalid." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 无效。"
          }
        }
