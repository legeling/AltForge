    },
    "AltForge Server did not return a recognizable reason for this failure." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltForge Server 未返回可识别的失败原因。"
          }
