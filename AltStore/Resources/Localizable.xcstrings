          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要安装一个占位 App，为设备转为完美越狱做准备。\n\n这可能需要一些时间。"
          }
        }
      }
    },
    "A source cannot change its identifier once added. This source can no longer be updated." : {
      "localizations" : {
