    },
    "%@ is running %@ %@, but AltForge requires %@ %@ or later." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is running %2$@ %3$@, but AltForge requires %4$@ %5$@ or later."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 当前运行 %2$@ %3$@，但 AltForge 要求 %4$@ %5$@ 或更高版本。"
          }
        }
      }
    },
    "%@ was successfully installed on %@." : {
      "localizations" : {
