          }
        }
      }
    },
    "Check the connection to AltForge Server, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查与 AltForge Server 的连接后重试。"
          }
        }
      }
    },
    "Check the device date and time. If the problem continues, try another trusted network." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
