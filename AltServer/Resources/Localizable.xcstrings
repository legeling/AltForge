          }
        }
      }
    },
    "Check the network and device date and time, then update AltForge Server before retrying." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查网络以及设备的日期与时间，更新 AltForge Server 后重试。"
          }
        }
      }
    },
    "Check the network connection and try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查网络连接后重试。"
          }
        }
      }
    },
    "Check the network, then update AltForge and AltForge Server before retrying." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查网络，更新 AltForge 和 AltForge Server 后重试。"
          }
        }
      }
    },
    "Check the source address and content. If it is maintained by someone else, contact the source maintainer." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查软件源地址和内容。如果软件源由他人维护，请联系维护者处理。"
          }
        }
      }
    },
    "Check this Mac's date and time, then update AltForge Server before retrying." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查这台 Mac 的日期与时间，更新 AltForge Server 后重试。"
          }
        }
      }
    },
    "Choose the app again and make sure it is a complete, unmodified IPA file." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重新选择 App，并确认它是完整且未经修改的 IPA 文件。"
          }
        }
      }
    },
    "Create an app-specific password at appleid.apple.com, then sign in with it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
