{
  "sourceLanguage" : "en",
  "strings" : {
    "Deactivate one sideloaded app, then try again. If an offloaded app is still counted, reinstall or delete it before retrying." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先停用一个侧载 App，然后重试。如果已卸载的 App 仍被计入，请重新安装或彻底删除后再试。"
          }
        }
      }
    },
    "Diagnostic ID" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "诊断编号"
          }
        }
      }
    },
    "Failure Stage" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失败阶段"
          }
        }
      }
    },
    "Operation Trace" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作轨迹"
          }
        }
