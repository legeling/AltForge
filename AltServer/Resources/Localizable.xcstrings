          }
        }
      }
    },
    "Keep the device unlocked and connected, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请保持设备解锁并连接，然后重试。"
          }
        }
      }
    },
    "Keep the device unlocked and open More Details for the device's installation reason." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
