      }
    },
    "Apple's authentication service returned a response that AltForge Server could not read." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 认证服务返回了 AltForge Server 无法读取的数据。"
          }
        }
      }
    },
    "Check that the file is accessible, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认文件可以访问后重试。"
          }
        }
      }
    },
    "Check that this Apple ID can use Apple Developer services and has accepted the latest Apple agreements, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认此 Apple ID 可以使用 Apple 开发者服务，并已接受 Apple 的最新协议，然后重试。"
          }
        }
      }
    },
    "Check the Apple ID account status, device date and time, then sign in again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查 Apple ID 状态以及设备的日期与时间，然后重新登录。"
          }
        }
      }
    },
    "Check the Apple ID and password, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查 Apple ID 和密码后重试。"
          }
        }
      }
    },
    "Check the account status and network connection, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查账号状态和网络连接后重试。"
          }
        }
      }
    },
    "Check the computer's date and time, then update AltForge Server before retrying." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
